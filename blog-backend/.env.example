SECRET_KEY=dev-secret-change-me-in-production
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Web)
